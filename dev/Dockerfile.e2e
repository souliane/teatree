# Browser binaries here must match the `playwright` client `uv.lock` resolves, or every
# run dies at browser launch before any test body executes. Pinned by
# `tests/test_playwright_image_pin.py`, which reds when the two drift.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble AS base
# `patch` is the binary the `patchy` dependency shells out to at import time.
RUN apt-get update -qq && \
    apt-get install -y -qq direnv jq patch && \
    rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh -s -- -q
ENV PATH="/root/.local/bin:$PATH"
WORKDIR /app
